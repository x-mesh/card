{
  "org": "x-mesh",
  "title": "x-mesh — layers",
  "command": "xm layers",
  "footer": {
    "lead": "each layer stands alone.",
    "dim": "take one, or wire them together."
  },
  "exclude": [
    "x-kit",
    ".github"
  ],
  "layers": [
    {
      "id": "environment",
      "color": "cyan",
      "hex": "#0969da",
      "repos": [
        "term-mesh"
      ],
      "owns": "where agents run",
      "wired": "term-mesh ⇄ xm   contract in code",
      "lead": "Where agents run.",
      "body": "A team of them in parallel, each in its own sandboxed worktree, local or over SSH."
    },
    {
      "id": "harness",
      "color": "purple",
      "hex": "#8250df",
      "repos": [
        "xm"
      ],
      "owns": "what gets built, and whether it ships",
      "wired": "gk → xm          finish --gate",
      "lead": "What gets built, and whether it ships.",
      "body": "Repository-grounded plans, the smallest sufficient change, a cross-vendor panel that gates the result."
    },
    {
      "id": "context",
      "color": "green",
      "hex": "#1a7f37",
      "repos": [
        "mem-mesh"
      ],
      "tag": "(opt-in)",
      "owns": "what survives the session",
      "wired": "follows the agent, not the app",
      "wiredColor": "green",
      "lead": "What survives the session.",
      "body": "It attaches at the agent, not at the app, so any environment above picks it up. Nothing here requires it.",
      "rail": true
    },
    {
      "id": "version control",
      "color": "orange",
      "hex": "#bc4c00",
      "repos": [
        "gk"
      ],
      "owns": "staying recoverable",
      "measure": {
        "kind": "fileInRepos",
        "path": ".gk.yaml",
        "template": "runs under {hit} of the {total} repos here"
      },
      "lead": "Staying recoverable.",
      "body": "Reflog-backed undo, time-machine restore, policies as code.",
      "rail": true
    },
    {
      "id": "operations",
      "color": "dim",
      "hex": "#57606a",
      "repos": [
        "aic",
        "edc",
        "httprove",
        "dbops"
      ],
      "owns": "what broke after it shipped",
      "wired": "standalone · none calls another",
      "lead": "What broke after it shipped.",
      "body": "Diagnosis is read-only and stops at the fault. Anything that writes makes you type the target's name first."
    }
  ],
